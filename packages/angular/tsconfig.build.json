{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@openpush/web": [
        "../../dist/npm/openpush.d.ts"
      ]
    },
    "experimentalDecorators": true
  },
  "include": [
    "src"
  ],
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
